{
  "$schema": "https://opencode.ai/config.json",
  "instructions": ["AGENTS.md", "docs/conventions.md"],
  "permission": {
    "bash": {
      "git push*--force*": "deny",
      "git push*-f *": "deny",
      "git push*main*": "deny",
      "*--no-verify*": "deny",
      "git filter-repo*": "deny",
      "git filter-branch*": "deny",
      "git rebase*": "deny",
      "git reset --hard*": "deny",
      "git config*": "deny",
      "gh pr merge*": "deny",
      "gh pr review*": "deny",
      "gh pr close*": "deny",
      "gh issue close*": "deny",
      "gh issue delete*": "deny",
      "gh repo delete*": "deny",
      "gh repo archive*": "deny",
      "gh release*": "deny",
      "gh api*DELETE*": "deny",
      "gh ruleset*": "deny",
      "sudo*": "deny",
      "rm -rf /*": "deny",
      "rm -rf ~*": "deny",
      "npm publish*": "deny",
      "uv publish*": "deny",
      "twine*": "deny"
    }
  },
  "command": {
    "queue": {
      "description": "Take the next agent-ready issue and open one PR for it",
      "template": "Work the issue queue exactly as AGENTS.md section 7 describes: take the lowest-numbered open issue labelled agent-ready, branch, implement only its acceptance criteria, run `make check`, commit, push, open one pull request that closes it, then stop and report. Do not start a second issue."
    }
  }
}
